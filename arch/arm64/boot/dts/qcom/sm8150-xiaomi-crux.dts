/dts-v1/;

#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
#include <dt-bindings/gpio/gpio.h>
#include "sm8150.dtsi"
#include "pm8150.dtsi"
#include "pm8150b.dtsi"
#include "pm8150l.dtsi"
#include <dt-bindings/iio/qcom,spmi-vadc.h>
#include <dt-bindings/soc/qcom,apr.h>
#include <dt-bindings/sound/qcom,q6afe.h>
#include <dt-bindings/sound/qcom,q6asm.h>
#include <dt-bindings/sound/qcom,wcd934x.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interconnect/qcom,sm8150.h>
#include <dt-bindings/usb/pd.h>

/ {
	model = "Xiaomi Mi 9 Pro 5G (crux)";
	compatible = "xiaomi,crux", "qcom,sm8150";
	chassis-type = "handset";

	aliases {
		serial0 = &uart2;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	vph_pwr: vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;
	};

	/*
	 * Apparently RPMh does not provide support for PM8150 S4 because it
	 * is always-on; model it as a fixed regulator.
	 */
	vreg_s4a_1p8: pm8150-s4 {
		compatible = "regulator-fixed";
		regulator-name = "vreg_s4a_1p8";

		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;

		regulator-always-on;
		regulator-boot-on;

		vin-supply = <&vph_pwr>;
	};

	/* [crux] 复刻原厂 tavil 卡拓扑：MI2S BE 用 dummy codec */
	dummy_codec: dummy-codec {
		compatible = "linux,spdif-dit";
		#sound-dai-cells = <0>;
		status = "okay";
	};


	thermal_zones: thermal-zones {
		pm8150b-ibat-lvl0 {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&pm8150b_bcl 0>;

			trips {
				pm8150b_ibat_lvl0: ibat-lvl0 {
					temperature = <4500>;
					hysteresis = <200>;
					type = "passive";
				};
			};
		};
		pm8150b-ibat-lvl1 {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&pm8150b_bcl 1>;

			trips {
				pm8150b_ibat_lvl1: ibat-lvl1 {
					temperature = <5000>;
					hysteresis = <200>;
					type = "passive";
				};
			};
		};
		pm8150b-vbat-lvl0 {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&pm8150b_bcl 2>;

			trips {
				pm8150b_vbat_lvl0: vbat-lvl0 {
					temperature = <3000>;
					hysteresis = <200>;
					type = "passive";
				};
			};
		};
		pm8150b-vbat-lvl1 {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&pm8150b_bcl 3>;

			trips {
				pm8150b_vbat_lvl1: vbat-lvl1 {
					temperature = <2800>;
					hysteresis = <200>;
					type = "passive";
				};
			};
		};
		pm8150b-vbat-lvl2 {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&pm8150b_bcl 4>;

			trips {
				pm8150b_vbat_lvl2: vbat-lvl2 {
					temperature = <2600>;
					hysteresis = <200>;
					type = "passive";
				};
			};
		};
		pm8150b-bcl-lvl0 {
			polling-delay-passive = <100>;
			polling-delay = <0>;
			thermal-sensors = <&pm8150b_bcl 5>;

			trips {
				pm8150b_bcl_lvl0: bcl-lvl0 {
					temperature = <1>;
					hysteresis = <200>;
					type = "passive";
				};
			};
			cooling-maps {
				map0 {
					trip = <&pm8150b_bcl_lvl0>;
					cooling-device = <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
		pm8150b-bcl-lvl1 {
			polling-delay-passive = <100>;
			polling-delay = <0>;
			thermal-sensors = <&pm8150b_bcl 6>;

			trips {
				pm8150b_bcl_lvl1: bcl-lvl1 {
					temperature = <1>;
					hysteresis = <200>;
					type = "passive";
				};
			};
			cooling-maps {
				map0 {
					trip = <&pm8150b_bcl_lvl1>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
		pm8150b-bcl-lvl2 {
			polling-delay-passive = <100>;
			polling-delay = <0>;
			thermal-sensors = <&pm8150b_bcl 7>;

			trips {
				pm8150b_bcl_lvl2: bcl-lvl2 {
					temperature = <1>;
					hysteresis = <200>;
					type = "passive";
				};
			};
			cooling-maps {
				map0 {
					trip = <&pm8150b_bcl_lvl2>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
		pm8150l-vph-lvl0 {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&pm8150l_bcl 2>;

			trips {
				pm8150l_vph_lvl0: vph-lvl0 {
					temperature = <3000>;
					hysteresis = <200>;
					type = "passive";
				};
			};
		};
		pm8150l-vph-lvl1 {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&pm8150l_bcl 3>;

			trips {
				pm8150l_vph_lvl1: vph-lvl1 {
					temperature = <2750>;
					hysteresis = <200>;
					type = "passive";
				};
			};
		};
		pm8150l-vph-lvl2 {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&pm8150l_bcl 4>;

			trips {
				pm8150l_vph_lvl2: vph-lvl2 {
					temperature = <2500>;
					hysteresis = <200>;
					type = "passive";
				};
			};
		};
		pm8150l-bcl-lvl0 {
			polling-delay-passive = <100>;
			polling-delay = <0>;
			thermal-sensors = <&pm8150l_bcl 5>;

			trips {
				pm8150l_bcl_lvl0: bcl-lvl0 {
					temperature = <1>;
					hysteresis = <200>;
					type = "passive";
				};
			};
			cooling-maps {
				map0 {
					trip = <&pm8150l_bcl_lvl0>;
					cooling-device = <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
		pm8150l-bcl-lvl1 {
			polling-delay-passive = <100>;
			polling-delay = <0>;
			thermal-sensors = <&pm8150l_bcl 6>;

			trips {
				pm8150l_bcl_lvl1: bcl-lvl1 {
					temperature = <1>;
					hysteresis = <200>;
					type = "passive";
				};
			};
			cooling-maps {
				map0 {
					trip = <&pm8150l_bcl_lvl1>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
		pm8150l-bcl-lvl2 {
			polling-delay-passive = <100>;
			polling-delay = <0>;
			thermal-sensors = <&pm8150l_bcl 7>;

			trips {
				pm8150l_bcl_lvl2: bcl-lvl2 {
					temperature = <1>;
					hysteresis = <200>;
					type = "passive";
				};
			};
			cooling-maps {
				map0 {
					trip = <&pm8150l_bcl_lvl2>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
	};
};

&spmi_bus {
	pmic@0 {
		crux_revid_0: revid@100 {
			compatible = "qcom,qpnp-revid";
			reg = <0x100 0x100>;
		};

		clock-controller@5b00 {
			compatible = "qcom,spmi-clkdiv";
			reg = <0x5b00 0x200>;
			#clock-cells = <1>;
			qcom,num-clkdivs = <2>;
			clock-output-names = "pm8150_div_clk1", "pm8150_div_clk2";
			clocks = <&rpmhcc RPMH_CXO_CLK>;
			clock-names = "xo";
		};

		crux_sdam_2: sdam@b100 {
			compatible = "qcom,spmi-sdam";
			reg = <0xb100 0x100>;
			#address-cells = <1>;
			#size-cells = <1>;
			rtc_offset: rtc-offset@bc {
				reg = <0xbc 0x4>;
			};

			/* [crux] 关机裁决记录：4字节，PMIC 常电域，扛得住真断电。 */
			crux_verdict: crux-verdict@90 {
				reg = <0x90 0x4>;
			};
		};
	};

	pmic@2 {
		crux_revid_2: revid@100 {
			compatible = "qcom,qpnp-revid";
			reg = <0x100 0x100>;
		};

		clock-controller@6000 {
			compatible = "qcom,spmi-clkdiv";
			reg = <0x6000 0x100>;
			#clock-cells = <1>;
			qcom,num-clkdivs = <1>;
			clock-output-names = "pm8150b_div_clk1";
			clocks = <&rpmhcc RPMH_CXO_CLK>;
			clock-names = "xo";
		};

		pm8150b_bcl: bcl@1d00 {
			compatible = "qcom,bcl-v5";
			reg = <0x1d00 0x100>;
			interrupts = <0x02 0x1d 0x00 0x00 0x02 0x1d 0x01 0x00 0x02 0x1d 0x02 0x00>;
			interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
			#thermal-sensor-cells = <1>;
		};

		pm8150b_pdphy: qcom,usb-pdphy@1700 {
			compatible = "qcom,qpnp-pdphy";
			reg = <0x1700 0x100>;
			vdd-pdphy-supply = <&vreg_l2a_3p1>;
			vbus-supply = <&pm8150b_vbus>;
			interrupts = <0x2 0x17 0x0 IRQ_TYPE_EDGE_RISING>,
				     <0x2 0x17 0x1 IRQ_TYPE_EDGE_RISING>,
				     <0x2 0x17 0x2 IRQ_TYPE_EDGE_RISING>,
				     <0x2 0x17 0x3 IRQ_TYPE_EDGE_RISING>,
				     <0x2 0x17 0x4 IRQ_TYPE_EDGE_RISING>,
				     <0x2 0x17 0x5 IRQ_TYPE_EDGE_RISING>,
				     <0x2 0x17 0x6 IRQ_TYPE_EDGE_RISING>,
				     <0x2 0x17 0x7 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "sig-tx", "sig-rx", "msg-tx", "msg-rx",
				  "msg-tx-failed", "msg-tx-discarded", "msg-rx-discarded", "fr-swap";
			qcom,default-sink-caps = <5000 3000>, <9000 3000>, <12000 2250>;
		};

	};

	pmic@3 {
		crux_lpg_3: pwms@b100 {
			compatible = "qcom,pwm-lpg";
			reg = <0xb100 0x200>;
			reg-names = "lpg-base";
			#pwm-cells = <2>;
			qcom,num-lpg-channels = <2>;
		};

		leds@d000 {
			compatible = "qcom,tri-led";
			reg = <0xd000 0x100>;
			nvmem-names = "pbs_sdam";
			nvmem = <&crux_sdam_2>;

			hr_led1 {
				label = "hr_led1";
				pwms = <&crux_lpg_3 0 1000000>;
				led-sources = <0>;
			};

			hr_led2 {
				label = "hr_led2";
				pwms = <&crux_lpg_3 1 1000000>;
				led-sources = <1>;
			};
		};

		haptics@c000 {
			compatible = "qcom,haptics";
			reg = <0xc000 0x100>;
			interrupts = <0x03 0xc0 0x00 0x03 0x03 0xc0 0x01 0x03>;
			interrupt-names = "hap-sc-irq", "hap-play-irq";
			qcom,actuator-type = "lra";
			qcom,vmax-mv = <0xd48>;
			qcom,play-rate-us = <0x1a0b>;
			qcom,lra-resonance-sig-shape = "sine";
			qcom,lra-auto-resonance-mode = "qwd";
			qcom,lra-allow-variable-play-rate;

			wf_0 {
				qcom,effect-id = <0>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-pattern = [3e 3e 3e];
				qcom,wf-play-rate-us = <0x1a0b>;
				qcom,wf-brake-pattern = <0x1000000>;
				qcom,lra-auto-resonance-disable;
			};

			wf_1 {
				qcom,effect-id = <1>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-pattern = <0x7e7e0202 0x2020202>;
				qcom,wf-play-rate-us = <0x1be7>;
				qcom,wf-repeat-count = <2>;
				qcom,wf-s-repeat-count = <1>;
				qcom,lra-auto-resonance-disable;
			};

			wf_2 {
				qcom,effect-id = <2>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-pattern = [7e 7e];
				qcom,wf-play-rate-us = <0xfa0>;
				qcom,lra-auto-resonance-disable;
			};

			wf_3 {
				qcom,effect-id = <3>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-pattern = [7e 7e 7e];
				qcom,wf-play-rate-us = <0x1a0b>;
				qcom,lra-auto-resonance-disable;
			};

			wf_4 {
				qcom,effect-id = <4>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-pattern = [7e 7e];
				qcom,wf-play-rate-us = <0x1388>;
				qcom,lra-auto-resonance-disable;
			};

			wf_5 {
				qcom,effect-id = <5>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-pattern = [7e 7e 7e];
				qcom,wf-play-rate-us = <0x1a0b>;
				qcom,wf-brake-pattern = <0x3000000>;
				qcom,lra-auto-resonance-disable;
			};
		};
	};

	pmic@4 {
		crux_revid_4: revid@100 {
			compatible = "qcom,qpnp-revid";
			reg = <0x100 0x100>;
		};

		clock-controller@5b00 {
			compatible = "qcom,spmi-clkdiv";
			reg = <0x5b00 0x100>;
			#clock-cells = <1>;
			qcom,num-clkdivs = <1>;
			clock-output-names = "pm8150l_div_clk1";
			clocks = <&rpmhcc RPMH_CXO_CLK>;
			clock-names = "xo";
		};

		pm8150l_bcl: bcl@3d00 {
			compatible = "qcom,bcl-v5";
			reg = <0x3d00 0x100>;
			interrupts = <0x04 0x3d 0x00 0x00 0x04 0x3d 0x01 0x00 0x04 0x3d 0x02 0x00>;
			interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
			#thermal-sensor-cells = <1>;
		};
	};

	pmic@5 {
		crux_lpg_5: pwms@b100 {
			compatible = "qcom,pwm-lpg";
			reg = <0xb100 0x300 0xb000 0x100>;
			reg-names = "lpg-base", "lut-base";
			#pwm-cells = <2>;
			qcom,num-lpg-channels = <3>;
			qcom,lut-patterns = <0 1 2 3 4 5 7 9 11 13 15 13 11 9 7 5 4 3 2 1 0>;
		};

		leds@d000 {
			compatible = "qcom,tri-led";
			reg = <0xd000 0x100>;

			red {
				label = "white";
				pwms = <&crux_lpg_5 0 1000000>;
				led-sources = <0>;
			};

			green {
				label = "green";
				pwms = <&crux_lpg_5 1 1000000>;
				led-sources = <1>;
				linux,default-trigger = "timer";
				status = "disabled";
			};

			blue {
				label = "blue";
				pwms = <&crux_lpg_5 2 1000000>;
				led-sources = <2>;
			};
		};

		lcdb@ec00 {
			compatible = "qcom,qpnp-lcdb-regulator";
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0xec00 0x100>;
			interrupts = <0x05 0xec 0x01 0x01>;
			interrupt-names = "sc-irq";
			qcom,pmic-revid = <&crux_revid_4>;
			qcom,voltage-step-ramp;
			status = "okay";

			ldo {
				label = "ldo";
				regulator-name = "lcdb_ldo";
				regulator-min-microvolt = <4000000>;
				regulator-max-microvolt = <6000000>;
			};

			ncp {
				label = "ncp";
				regulator-name = "lcdb_ncp";
				regulator-min-microvolt = <4000000>;
				regulator-max-microvolt = <6000000>;
			};

			bst {
				label = "bst";
				regulator-name = "lcdb_bst";
				regulator-min-microvolt = <4700000>;
				regulator-max-microvolt = <6275000>;
			};
		};

	};
};


&apps_rsc {
	regulators-0 {
		compatible = "qcom,pm8150-rpmh-regulators";
		qcom,pmic-id = "a";

		vdd-s1-supply = <&vph_pwr>;
		vdd-s2-supply = <&vph_pwr>;
		vdd-s3-supply = <&vph_pwr>;
		vdd-s4-supply = <&vph_pwr>;
		vdd-s5-supply = <&vph_pwr>;
		vdd-s6-supply = <&vph_pwr>;
		vdd-s7-supply = <&vph_pwr>;
		vdd-s8-supply = <&vph_pwr>;
		vdd-s9-supply = <&vph_pwr>;
		vdd-s10-supply = <&vph_pwr>;

		vdd-l1-l8-l11-supply = <&vreg_s6a_0p9>;
		vdd-l2-l10-supply = <&vreg_bob>;
		vdd-l3-l4-l5-l18-supply = <&vreg_s6a_0p9>;
		vdd-l6-l9-supply = <&vreg_s8c_1p3>;
		vdd-l7-l12-l14-l15-supply = <&vreg_s5a_2p0>;
		vdd-l13-l16-l17-supply = <&vreg_bob>;

		vreg_s5a_2p0: smps5 {
			regulator-min-microvolt = <1904000>;
			regulator-max-microvolt = <2000000>;
		};

		vreg_s6a_0p9: smps6 {
			regulator-min-microvolt = <920000>;
			regulator-max-microvolt = <1128000>;
		};

		vdda_wcss_pll:
		vreg_l1a_0p75: ldo1 {
